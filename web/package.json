{
  "name": "chifaa-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test --test-isolation=none tests/*.test.ts",
    "test:db": "tsx --test --test-isolation=none tests/database.test.ts",
    "db:types": "tsx scripts/generate-db-types.ts",
    "db:package": "tsx scripts/package-supabase-dev.ts",
    "admin:bootstrap": "tsx scripts/prepare-first-admin.ts",
    "verify": "npm run db:types && npm run typecheck && npm run lint && npm test && npm run build",
    "benchmark": "tsx scripts/benchmark.ts",
    "test:design": "node scripts/design-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "decimal.js": "^10.6.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.2"
  }
}
